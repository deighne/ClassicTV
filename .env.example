# Classic TV 3.0 — Environment Variable Reference
#
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env to version control — it contains secrets.
#
# The Schedule_Service reads these variables at startup. Missing required
# variables cause an immediate exit with an error message identifying the
# missing variable (Requirement 33.1).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Jellyfin API key. Generate one in Jellyfin → Dashboard → API Keys.
# The Schedule_Service exits at startup if this variable is absent.
JELLYFIN_API_KEY=

# Jellyfin item ID for the Offline_Clip — the looping "nothing on air" video.
# This item must exist in Jellyfin and be direct-play compatible.
# Used as the fallback when a channel has no valid content for a time slot.
OFFLINE_CLIP_JELLYFIN_ID=

# ---------------------------------------------------------------------------
# Optional — defaults shown
# ---------------------------------------------------------------------------

# Full base URL of the Jellyfin instance, including scheme and host.
# Default: http://localhost:8096
# Change this if Jellyfin is on a different host or port, or if you want HTTPS.
JELLYFIN_BASE_URL=http://localhost:8096

# Jellyfin HTTP port. Used only when JELLYFIN_BASE_URL is not set and the
# service constructs the URL from a hostname alone.
# Default: 8096 (matches JELLYFIN_DEFAULT_PORT in server/constants.py)
JELLYFIN_DEFAULT_PORT=8096

# HTTP port the Schedule_Service binds to.
# Default: 8300 (matches SCHEDULE_SERVICE_PORT in server/constants.py)
SERVICE_PORT=8300

# Absolute path to the directory containing per-channel YAML configuration files.
# The service watches this directory for changes and hot-reloads within 5 seconds.
# Default: channels/ relative to the repository root (resolved at startup)
CHANNEL_CONFIG_DIR=channels

# ---------------------------------------------------------------------------
# Deployment targets (used by deploy/ scripts & tools/)
# ---------------------------------------------------------------------------
JFMAC_USER=your-user
JFMAC_HOST=192.168.1.10
REMOTE_DIR=/path/to/ClassicTV
SWEET_POTATO_IP=192.168.1.20
SSH_JUMP_HOSTS=
DEVICE_HOST=root@192.168.1.20
SERVER_HOST=your-user@192.168.1.10
