<?xml version="1.0" encoding="UTF-8"?>
<!--
  Channel ident & CRT static overlay (Sony Trinitron Green OSD edition).

  Labels are bound to Window(Home) properties rather than set via
  getControl().setLabel(): a WindowXMLDialog's controls are not addressable by
  id until the window has been initialised, so setting labels before show()
  raised "Non-Existent Control". Property binding also updates live if show_for()
  is called again while the overlay is already visible.
-->
<window type="dialog" id="3302">
    <controls>
        <!--
          Full-bleed dummy anchor. Its only job is to give the dialog window a
          1920x1080 bounding box so child controls can anchor relative to the screen.
          Uses a label with empty text — zero texture loads and zero draw calls.
        -->
        <control type="label">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <label></label>
        </control>

        <!--
          Frame-stepped CRT static snow (controls 5010–5013).
          Uses a single crisp 640x360 grayscale noise texture (static_tile.png)
          shared across 4 flipx/flipy variants, switched via ClassicTV.StaticFrame
          with zero slide/pulse/fade so it cuts cleanly like a real RF tuner.
        -->
        <control type="image" id="5010">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E6FFFFFF">static_tile.png</texture>
            <aspectratio>stretch</aspectratio>
            <visible>!String.IsEmpty(Window(Home).Property(ClassicTV.StaticVisible)) + String.IsEqual(Window(Home).Property(ClassicTV.StaticFrame),0)</visible>
        </control>
        <control type="image" id="5011">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E6FFFFFF" flipx="true">static_tile.png</texture>
            <aspectratio>stretch</aspectratio>
            <visible>!String.IsEmpty(Window(Home).Property(ClassicTV.StaticVisible)) + String.IsEqual(Window(Home).Property(ClassicTV.StaticFrame),1)</visible>
        </control>
        <control type="image" id="5012">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E6FFFFFF" flipy="true">static_tile.png</texture>
            <aspectratio>stretch</aspectratio>
            <visible>!String.IsEmpty(Window(Home).Property(ClassicTV.StaticVisible)) + String.IsEqual(Window(Home).Property(ClassicTV.StaticFrame),2)</visible>
        </control>
        <control type="image" id="5013">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E6FFFFFF" flipx="true" flipy="true">static_tile.png</texture>
            <aspectratio>stretch</aspectratio>
            <visible>!String.IsEmpty(Window(Home).Property(ClassicTV.StaticVisible)) + String.IsEqual(Window(Home).Property(ClassicTV.StaticFrame),3)</visible>
        </control>

        <!--
          Sony Trinitron Phosphor-Green CRT OSD (Top-Right corner).
          Inset 80px from right and 64px from top for CRT overscan safety.
          528x152 px footprint with deep phosphor-black backing plate so green
          characters remain razor-sharp over both static snow and bright scenes.
        -->
        <control type="group" id="5005">
            <visible>!String.IsEmpty(Window(Home).Property(ClassicTV.BugVisible))</visible>
            <animation effect="fade" start="0" end="100" time="120">Visible</animation>
            <animation effect="fade" start="100" end="0" time="200">Hidden</animation>

            <!-- Drop shadow -->
            <control type="image">
                <right>74</right>
                <top>70</top>
                <width>528</width>
                <height>152</height>
                <texture colordiffuse="80000000">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>

            <!-- Deep CRT phosphor-black backing panel (~80% opacity) -->
            <control type="image">
                <right>80</right>
                <top>64</top>
                <width>528</width>
                <height>152</height>
                <texture colordiffuse="CC030B05">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>

            <!-- Phosphor-green left accent bar (4px) -->
            <control type="image">
                <right>604</right>
                <top>64</top>
                <width>4</width>
                <height>152</height>
                <texture colordiffuse="FF22FF44">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>

            <!-- Top & bottom scanline border rules -->
            <control type="image">
                <right>80</right>
                <top>64</top>
                <width>524</width>
                <height>2</height>
                <texture colordiffuse="6622FF44">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>
            <control type="image">
                <right>80</right>
                <top>214</top>
                <width>524</width>
                <height>2</height>
                <texture colordiffuse="6622FF44">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>

            <!-- Internal divider line below CH header -->
            <control type="image">
                <right>96</right>
                <top>130</top>
                <width>492</width>
                <height>1</height>
                <texture colordiffuse="4422FF44">white.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>

            <!-- Channel number ("CH 04", "CH 15", or "CH 1_") -->
            <control type="label" id="5000">
                <right>260</right>
                <top>70</top>
                <width>328</width>
                <height>56</height>
                <font>font45_title</font>
                <align>left</align>
                <aligny>center</aligny>
                <textcolor>FF22FF44</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window(Home).Property(ClassicTV.ChannelDisplay)]</label>
            </control>

            <!-- Trinitron OSD status badge (STEREO / DIRECT / TUNE / NOT FOUND) -->
            <control type="label">
                <right>96</right>
                <top>74</top>
                <width>160</width>
                <height>48</height>
                <font>Mono26</font>
                <align>right</align>
                <aligny>center</aligny>
                <textcolor>9922FF44</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label fallback="STEREO">$INFO[Window(Home).Property(ClassicTV.OSDBadge)]</label>
            </control>

            <!-- Channel name (full 492px width so long names never truncate) -->
            <control type="label" id="5001">
                <right>96</right>
                <top>135</top>
                <width>492</width>
                <height>38</height>
                <font>font30_title</font>
                <align>left</align>
                <aligny>center</aligny>
                <textcolor>FF22FF44</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window(Home).Property(ClassicTV.ChannelName)]</label>
            </control>

            <!-- Now Playing program title (soft phosphor green monospace) -->
            <control type="label" id="5002">
                <right>96</right>
                <top>175</top>
                <width>492</width>
                <height>34</height>
                <font>Mono26</font>
                <align>left</align>
                <aligny>center</aligny>
                <textcolor>DD88FF99</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window(Home).Property(ClassicTV.NowPlaying)]</label>
            </control>
        </control>
    </controls>
</window>
